---
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import PublicationItem from '@/components/PublicationItem.astro';
import SectionHead from '@/components/SectionHead.astro';
import headshot from '@/assets/images/headshot.jpg';
import { site, status } from '@/config';
import { profileLinks } from '@/utils/links';
import { byFileOrder, formatMonth, isoMonth } from '@/utils/format';

// Featured publications, in the order they appear in publications.yaml.
const featured = (await getCollection('publications')).filter((p) => p.data.featured).sort(byFileOrder);

// The three newest news items.
const recent = (await getCollection('news'))
  .sort((a, b) => b.data.date.localeCompare(a.data.date) || b.id.localeCompare(a.id))
  .slice(0, 3);

const education = (await getCollection('education')).sort(byFileOrder);

// School logos: files in src/assets/images/logos/ named after the entry id are
// picked up automatically. "<id>.png" is used in light mode; an optional
// "<id>-white.png" is used in dark mode (otherwise the same file is used).
const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/logos/*.{png,jpg,jpeg,webp,svg}', {
  eager: true,
});
function findLogo(name: string): ImageMetadata | undefined {
  const match = Object.entries(logoFiles).find(([path]) => path.split('/').pop()?.replace(/\.[^.]+$/, '') === name);
  return match?.[1].default;
}
function logoFor(id: string): { light: ImageMetadata; dark?: ImageMetadata } | undefined {
  const light = findLogo(id);
  return light ? { light, dark: findLogo(`${id}-white`) } : undefined;
}

// Fallback badge text when no logo file exists: "Duke University" -> "D", "HUST" stays "HUST".
function initials(org: string): string {
  const words = org.split(/\s+/).filter((w) => !['of', 'and', 'the', 'University'].includes(w));
  return words.map((w) => w[0]).join('').slice(0, 4);
}
---

<BaseLayout>
  <!-- Hero: intro on the left, portrait on the right, interests and links below -->
  <section class="container hero">
    <div class="hero-text">
      <h1 class="enter">{site.name}</h1>
      <p class="role enter" style="--i: 1">{site.role}</p>

      <p class="lead prose enter" style="--i: 2">
        I work in the <a href="https://horstmeyer.pratt.duke.edu/" target="_blank" rel="noopener"
          >Computational Optics Lab</a
        >, advised by <a href="https://bme.duke.edu/people/roarke-horstmeyer/" target="_blank" rel="noopener"
          >Prof. Roarke Horstmeyer</a
        >. My research bridges optical physics and machine learning to build high-throughput imaging systems that
        reveal biological dynamics previously invisible to standard microscopy.
      </p>

      {
        status && (
          <p class="status enter" style="--i: 3">
            <span class="dot" aria-hidden="true" />
            <span>
              {status}{' '}
              <a class="text-link" href={`mailto:${site.email}`}>
                Get in touch
              </a>
            </span>
          </p>
        )
      }
    </div>

    <div class="portrait enter" style="--i: 1">
      <Image
        src={headshot}
        alt={`Portrait of ${site.name}`}
        widths={[220, 440, 600]}
        sizes="(max-width: 760px) 112px, 220px"
        priority
      />
    </div>

    <div class="hero-meta">
      <div class="interests enter" style="--i: 3">
        <h2 class="interests-label">Research interests</h2>
        <ul class="tags">
          {site.interests.map((tag) => <li>{tag}</li>)}
        </ul>
      </div>

      <ul class="pills enter" style="--i: 4">
        {
          profileLinks().map((link) => (
            <li>
              <a href={link.href} target={link.newTab ? '_blank' : undefined} rel="noopener">
                <Icon name={link.icon} size={15} />
                <span>{link.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Selected publications -->
  <section class="section">
    <div class="container">
      <SectionHead title="Selected publications" href="/publications/" linkLabel="All publications" />
      <div class="pub-list">
        {featured.map((pub) => <PublicationItem pub={pub} />)}
      </div>
    </div>
  </section>

  <!-- Recent news -->
  <section class="section">
    <div class="container">
      <SectionHead title="Recent news" href="/news/" linkLabel="All news" />
      <div class="tiles">
        {
          recent.map((item) => (
            <a class="news-tile reveal" href={`/news/#${item.id}`}>
              {item.data.images[0] && (
                <div class="frame media">
                  <Image
                    src={item.data.images[0].src}
                    alt={item.data.images[0].alt}
                    widths={[360, 540, 720]}
                    sizes="(max-width: 640px) 100vw, 330px"
                  />
                </div>
              )}
              <div class="news-body">
                <p class="eyebrow">
                  <time datetime={isoMonth(item.data.date)}>{formatMonth(item.data.date)}</time>
                </p>
                <h3>{item.data.summary}</h3>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Education & experience -->
  <section class="section">
    <div class="container">
      <SectionHead title="Education & experience" />
      <ol class="edu">
        {
          education.map(({ id, data }) => {
            const logo = logoFor(id);
            return (
              <li class="reveal">
                <div class="edu-logo" style={data.logoScale ? `--logo-scale: ${data.logoScale}` : undefined}>
                  {logo ? (
                    <>
                      <Image
                        src={logo.light}
                        alt={`${data.org} logo`}
                        widths={[72, 144, 216]}
                        sizes="72px"
                        class={logo.dark ? 'only-light' : undefined}
                      />
                      {logo.dark && (
                        <Image
                          src={logo.dark}
                          alt={`${data.org} logo`}
                          widths={[72, 144, 216]}
                          sizes="72px"
                          class="only-dark"
                        />
                      )}
                    </>
                  ) : (
                    <span aria-hidden="true">{data.abbr ?? initials(data.org)}</span>
                  )}
                </div>
                <div class="edu-main">
                  <h3>{data.org}</h3>
                  <p class="edu-role">{data.role}</p>
                  <p class="edu-desc">{data.description}</p>
                  {data.advisor && (
                    <p class="edu-advisor">
                      Advisor:{' '}
                      {data.advisor.url ? (
                        <a class="text-link" href={data.advisor.url} target="_blank" rel="noopener">
                          {data.advisor.name}
                        </a>
                      ) : (
                        data.advisor.name
                      )}
                    </p>
                  )}
                </div>
                <p class="edu-years">{data.years}</p>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero
     ======================================================================== */

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'text portrait'
      'meta meta';
    column-gap: clamp(32px, 6vw, 72px);
    align-items: center;
    padding-top: clamp(36px, 6vw, 72px);
    padding-bottom: clamp(24px, 4vw, 40px);
  }

  .hero-text {
    grid-area: text;
  }

  .portrait {
    grid-area: portrait;
  }

  /* Interests and links span the full width under the intro and portrait */
  .hero-meta {
    grid-area: meta;
  }

  h1 {
    font-size: clamp(40px, 5.6vw, 58px);
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .role {
    margin-top: 10px;
    font-size: clamp(17px, 1.9vw, 20px);
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--text-2);
  }

  .lead {
    max-width: 600px;
    margin-top: 20px;
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--text-2);
  }

  /* Availability line: green dot, short sentence, contact link */
  .status {
    display: inline-flex;
    align-items: flex-start;
    gap: 10px;
    margin-top: 18px;
    padding: 7px 14px 7px 12px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--text);
  }

  .status .dot {
    flex: none;
    width: 8px;
    height: 8px;
    margin-top: 6px;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 3px var(--ok-soft);
  }

  .status a {
    margin-left: 4px;
    color: var(--text-2);
    white-space: nowrap;
  }

  /* When the line wraps on phones, a rounded box reads better than a pill */
  @media (max-width: 560px) {
    .status {
      border-radius: 14px;
    }
  }

  /* Research interests: labeled, tinted tags */
  .interests {
    margin-top: 28px;
  }

  .interests-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }

  .tags li {
    padding: 5px 12px;
    border: 1px solid var(--tag-border);
    border-radius: 8px;
    background: var(--tag-bg);
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }

  .pills a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 34px;
    padding: 0 14px;
    border-radius: 999px;
    background: var(--pill);
    font-size: 13.5px;
    color: var(--text);
    transition: background-color 0.2s, transform 0.2s var(--ease);
  }

  .pills a:hover {
    background: var(--pill-hover);
  }

  .pills a:active {
    transform: scale(0.97);
  }

  .pills :global(svg) {
    color: var(--text-2);
    transition: color 0.2s;
  }

  .pills a:hover :global(svg) {
    color: var(--text);
  }

  .portrait {
    width: 220px;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 22px;
    background: var(--tile);
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'portrait'
        'text'
        'meta';
      row-gap: 20px;
    }

    .portrait {
      width: 112px;
      border-radius: 18px;
    }
  }

  /* Publications
     ======================================================================== */

  .pub-list {
    display: grid;
    gap: clamp(28px, 4vw, 40px);
  }

  /* News tiles
     ======================================================================== */

  .tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  @media (max-width: 860px) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .tiles {
      grid-template-columns: 1fr;
    }
  }

  .news-tile {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--card-edge);
    border-radius: var(--radius-lg);
    background: var(--tile);
    transition: background-color 0.3s;
  }

  .news-tile:hover {
    background: var(--tile-hover);
  }

  .news-tile .media {
    aspect-ratio: 16 / 10;
    border-radius: 0;
  }

  .news-tile:hover :global(img) {
    transform: scale(1.03);
  }

  .news-body {
    padding: 16px 20px 20px;
  }

  .news-body h3 {
    margin-top: 4px;
    font-size: 16px;
    line-height: 1.4;
    letter-spacing: -0.012em;
  }

  /* Education
     ======================================================================== */

  .edu li {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) auto;
    gap: 20px;
    align-items: start;
    padding-block: 22px;
    border-top: 1px solid var(--line);
  }

  /* School logo, shown without a frame. Wordmarks and emblems both fit the box. */
  .edu-logo {
    display: grid;
    place-items: center;
    width: 72px;
    height: 48px;
  }

  .edu-logo :global(img) {
    width: calc(100% * var(--logo-scale, 1));
    height: calc(100% * var(--logo-scale, 1));
    object-fit: contain;
  }

  /* Placeholder until a logo file is added */
  .edu-logo span {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-2);
  }

  .edu li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .edu h3 {
    font-size: 17.5px;
    letter-spacing: -0.015em;
  }

  .edu-role {
    margin-top: 2px;
    color: var(--text-2);
  }

  .edu-desc {
    max-width: 640px;
    margin-top: 8px;
    font-size: 14.5px;
    color: var(--text-3);
  }

  .edu-advisor {
    margin-top: 8px;
    font-size: 14.5px;
    color: var(--text-3);
  }

  .edu-years {
    font-size: 14.5px;
    color: var(--text-2);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 640px) {
    .edu li {
      grid-template-columns: 56px minmax(0, 1fr);
      grid-template-areas:
        'logo years'
        'logo main';
      column-gap: 14px;
      row-gap: 0;
    }

    .edu-logo {
      grid-area: logo;
      width: 56px;
      height: 40px;
    }

    .edu-main {
      grid-area: main;
    }

    .edu-years {
      grid-area: years;
      margin-bottom: 4px;
      font-size: 13px;
      font-weight: 500;
      color: var(--text-3);
    }
  }
</style>
