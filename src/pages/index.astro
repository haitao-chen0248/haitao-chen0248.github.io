---
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import Letters from '@/components/Letters.astro';
import Photo from '@/components/Photo.astro';
import PublicationItem from '@/components/PublicationItem.astro';
import SectionDock from '@/components/SectionDock.astro';
import SectionHead from '@/components/SectionHead.astro';
import headshot from '@/assets/images/headshot.jpg';
import { site, status } from '@/config';
import { profileLinks } from '@/utils/links';
import { byFileOrder, byNewest, formatMonth, isoMonth, wrapFriendly } from '@/utils/format';

// Featured publications, in the order they appear in publications.yaml.
const featured = (await getCollection('publications')).filter((p) => p.data.featured).sort(byFileOrder);

// The three newest news items.
const recent = (await getCollection('news')).sort(byNewest).slice(0, 3);

const education = (await getCollection('education')).sort(byFileOrder);

// Sections listed in the "On this page" dock.
const sections = [
  { id: 'about', label: 'About' },
  { id: 'publications', label: 'Publications' },
  { id: 'news', label: 'News' },
  { id: 'education', label: 'Education' },
];

// School logos: files in src/assets/images/logos/ named after the entry id are
// picked up automatically. "<id>.png" is used in light mode; an optional
// "<id>-white.png" is used in dark mode (otherwise the same file is used).
const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/logos/*.{png,jpg,jpeg,webp,svg}', {
  eager: true,
});
function findLogo(name: string): ImageMetadata | undefined {
  const match = Object.entries(logoFiles).find(([path]) => path.split('/').pop()?.replace(/\.[^.]+$/, '') === name);
  return match?.[1].default;
}
function logoFor(id: string): { light: ImageMetadata; dark?: ImageMetadata } | undefined {
  const light = findLogo(id);
  return light ? { light, dark: findLogo(`${id}-white`) } : undefined;
}

// Fallback badge text when no logo file exists: "Duke University" -> "D", "HUST" stays "HUST".
function initials(org: string): string {
  const words = org.split(/\s+/).filter((w) => !['of', 'and', 'the', 'University'].includes(w));
  return words.map((w) => w[0]).join('').slice(0, 4);
}
---

<BaseLayout>
  <!-- Hero: intro on the left, portrait on the right, interests and links below -->
  <section class="container hero" id="about">
    <div class="hero-text">
      <h1><Letters text={site.name} /></h1>
      <p class="role enter" style="--i: 1" set:html={wrapFriendly(site.role, true)} />

      <p class="lead prose enter" style="--i: 2">
        I work in the <a href="https://horstmeyer.pratt.duke.edu/" target="_blank" rel="noopener"
          >Computational Optics Lab</a
        >, advised by <a href="https://bme.duke.edu/people/roarke-horstmeyer/" target="_blank" rel="noopener"
          >Prof. Roarke Horstmeyer</a
        >. My research bridges optical physics and machine learning to build{' '}
        <span class="nowrap">high-throughput</span> imaging systems that reveal biological dynamics previously invisible to
        standard microscopy.
      </p>

      {
        status && (
          <p class="status glass enter" style="--i: 3">
            <span class="dot" aria-hidden="true" />
            <span>
              <Fragment set:html={wrapFriendly(status, true)} />{' '}
              <a class="text-link" href={`mailto:${site.email}`}>
                Get in touch
              </a>
            </span>
          </p>
        )
      }
    </div>

    <!-- The slot fades in with the hero; the photo inside tilts (script below) -->
    <div class="portrait-slot enter" style="--i: 1">
      <div class="portrait sheen">
        <Photo
          src={headshot}
          alt={`Portrait of ${site.name}`}
          widths={[220, 440, 600]}
          sizes="(max-width: 760px) 112px, 220px"
          priority
        />
      </div>
    </div>

    <div class="hero-meta">
      <div class="interests enter" style="--i: 3">
        <h2 class="interests-label">Research interests</h2>
        <ul class="tags">
          {site.interests.map((tag) => <li>{tag}</li>)}
        </ul>
      </div>

      <ul class="pills enter" style="--i: 4">
        {
          profileLinks().map((link) => (
            <li>
              <a class="glass" data-magnetic href={link.href} target={link.newTab ? '_blank' : undefined} rel="noopener">
                <Icon name={link.icon} size={15} />
                <span class="label">{link.label}</span>
                <span class="hit" aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Selected publications -->
  <section class="section" id="publications">
    <div class="container">
      <SectionHead title="Selected publications" href="/publications/" linkLabel="All publications" />
      <div class="pub-list">
        {featured.map((pub) => <PublicationItem pub={pub} compact />)}
      </div>
    </div>
  </section>

  <!-- Recent news -->
  <section class="section" id="news">
    <div class="container">
      <SectionHead title="Recent news" href="/news/" linkLabel="All news" />
      <div class="tiles">
        {
          recent.map((item) => (
            <a class="news-tile sheen lift reveal" href={`/news/#${item.id}`}>
              {item.data.images[0] && (
                <div class="frame media">
                  <Photo
                    src={item.data.images[0].src}
                    alt={item.data.images[0].alt}
                    widths={[192, 288, 360, 540, 720]}
                    sizes="(max-width: 560px) 96px, (max-width: 860px) 46vw, 330px"
                  />
                </div>
              )}
              <div class="news-body">
                <p class="eyebrow">
                  <time datetime={isoMonth(item.data.date)}>{formatMonth(item.data.date)}</time>
                </p>
                <h3 set:html={wrapFriendly(item.data.summary)} />
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Education & experience -->
  <section class="section" id="education">
    <div class="container">
      <SectionHead title="Education & experience" />
      <ol class="edu">
        {
          education.map(({ id, data }) => {
            const logo = logoFor(id);
            return (
              <li class="reveal">
                <div class="edu-logo" style={data.logoScale ? `--logo-scale: ${data.logoScale}` : undefined}>
                  {logo ? (
                    <>
                      <Image
                        src={logo.light}
                        alt={`${data.org} logo`}
                        widths={[72, 144, 216]}
                        sizes="72px"
                        class={logo.dark ? 'only-light' : undefined}
                      />
                      {logo.dark && (
                        <Image
                          src={logo.dark}
                          alt={`${data.org} logo`}
                          widths={[72, 144, 216]}
                          sizes="72px"
                          class="only-dark"
                        />
                      )}
                    </>
                  ) : (
                    <span aria-hidden="true">{data.abbr ?? initials(data.org)}</span>
                  )}
                </div>
                <div class="edu-main">
                  <h3>{data.org}</h3>
                  <p class="edu-role">{data.role}</p>
                  <p class="edu-desc" set:html={wrapFriendly(data.description)} />
                  {data.advisor && (
                    <p class="edu-advisor">
                      Advisor:{' '}
                      {data.advisor.url ? (
                        <a class="text-link" href={data.advisor.url} target="_blank" rel="noopener">
                          {data.advisor.name}
                        </a>
                      ) : (
                        data.advisor.name
                      )}
                    </p>
                  )}
                </div>
                <p class="edu-years">{data.years}</p>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>

  <SectionDock sections={sections} />
</BaseLayout>

<script>
  // Portrait tilt: the photo leans away from wherever the pointer is (mouse)
  // or a finger presses (touch), up to 5 degrees, and springs back when the
  // pointer leaves or the finger lifts. A scroll that starts on the photo
  // takes over the touch and also lets it go. Not with reduced motion.
  const portrait = document.querySelector<HTMLElement>('.portrait');
  if (portrait && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const max = 5;
    let touching = false;

    // offsetX/Y are in the photo's own, untilted coordinates.
    function lean(event: PointerEvent) {
      const x = event.offsetX / portrait!.clientWidth - 0.5;
      const y = event.offsetY / portrait!.clientHeight - 0.5;
      portrait!.style.setProperty('--tilt-x', `${(-y * 2 * max).toFixed(2)}deg`);
      portrait!.style.setProperty('--tilt-y', `${(x * 2 * max).toFixed(2)}deg`);
    }

    function settle() {
      touching = false;
      portrait!.classList.remove('tilting', 'pressed');
      portrait!.style.removeProperty('--tilt-x');
      portrait!.style.removeProperty('--tilt-y');
    }

    portrait.addEventListener('pointerenter', (event) => {
      if (event.pointerType !== 'mouse') return;
      portrait.classList.add('tilting');
      lean(event);
    });
    portrait.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse') return;
      touching = true;
      portrait.classList.add('tilting', 'pressed');
      lean(event);
    });
    portrait.addEventListener('pointermove', (event) => {
      if (event.pointerType === 'mouse' || touching) lean(event);
    });
    portrait.addEventListener('pointerleave', (event) => {
      if (event.pointerType === 'mouse') settle();
    });
    portrait.addEventListener('pointerup', (event) => {
      if (event.pointerType !== 'mouse') settle();
    });
    portrait.addEventListener('pointercancel', settle);
  }
</script>

<style>
  /* Hero
     ======================================================================== */

  /* The intro recedes as the page scrolls past it: it drifts slower than
     the page, which gives a sense of depth, and fades once mostly gone. */
  @keyframes recede {
    40% {
      opacity: 1;
    }

    to {
      opacity: 0;
      translate: 0 64px;
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      :where(.hero) {
        animation: recede linear both;
      }

      .hero {
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
    }
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'text portrait'
      'meta meta';
    column-gap: clamp(32px, 6vw, 72px);
    align-items: center;
    padding-top: clamp(36px, 6vw, 72px);
    padding-bottom: clamp(24px, 4vw, 40px);
  }

  .hero-text {
    grid-area: text;
  }

  .portrait-slot {
    grid-area: portrait;
  }

  /* Interests and links span the full width under the intro and portrait */
  .hero-meta {
    grid-area: meta;
  }

  h1 {
    font-size: clamp(44px, 6.4vw, 68px);
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .role {
    margin-top: 10px;
    font-size: clamp(17px, 1.9vw, 20px);
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--text-2);
    text-wrap: balance;
  }

  /* Wide enough for the intro to fill three lines on wide screens, rather
     than leave "standard microscopy." alone on a fourth. Narrower screens
     balance the lines instead, so the last one is never a short stub. The
     lab and the advisor's name are never split across lines. */
  .lead {
    max-width: 672px;
    margin-top: 20px;
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--text-2);
  }

  .lead a {
    white-space: nowrap;
  }

  @media (max-width: 1023px) {
    .lead {
      text-wrap: balance;
    }
  }

  /* Availability line: green dot, short sentence, contact link */
  .status {
    display: inline-flex;
    align-items: flex-start;
    gap: 10px;
    margin-top: 18px;
    padding: 7px 14px 7px 12px;
    border-radius: 999px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--text);
  }

  .status .dot {
    flex: none;
    width: 8px;
    height: 8px;
    margin-top: 6px;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 3px var(--ok-soft);
  }

  .status a {
    margin-left: 4px;
    color: var(--text-2);
    white-space: nowrap;
  }

  /* Research interests: labeled, tinted tags */
  .interests {
    margin-top: 28px;
  }

  .interests-label {
    font-family: var(--mono);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }

  .tags li {
    padding: 5px 12px;
    border: 1px solid var(--tag-border);
    border-radius: 8px;
    background: var(--tag-bg);
    backdrop-filter: blur(6px) saturate(180%);
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }

  /* Glass pills (the border comes from .glass, so the padding is 1px less) */
  .pills a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 34px;
    padding: 0 13px;
    border-radius: 999px;
    font-size: 13.5px;
    color: var(--text);
    transition:
      background-color 0.2s,
      transform 0.5s var(--spring),
      translate 0.6s var(--spring);
  }

  .pills a:active {
    background: var(--glass-fill-hover);
  }

  /* A taller tap area than the pill itself (44px), reaching into half the
     gap on either side. The pill's own ::before and ::after draw the glass,
     so the area is an empty span. Its offsets count from inside the 1px
     border. */
  .pills .hit {
    position: absolute;
    inset: -6px -5px;
  }

  @media (hover: hover) {
    .pills a:hover {
      background: var(--glass-fill-hover);
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .pills a:hover {
      transform: scale(1.04);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .pills a:active {
      transform: scale(0.95);
    }
  }

  .pills :global(svg) {
    flex: none;
    color: var(--text-2);
    transition: color 0.2s;
  }

  .pills a:active :global(svg) {
    color: var(--text);
  }

  @media (hover: hover) {
    .pills a:hover :global(svg) {
      color: var(--text);
    }
  }

  /* Between phone and desktop widths the tags wrap onto two or three lines:
     each line stretches its tags to the full width, so the block keeps
     straight edges (desktop has them all on one line, as they are) */
  @media (max-width: 899px) {
    .tags li {
      flex: 1 1 auto;
      text-align: center;
    }
  }

  /* Narrow desktops: the six tags fit on one line from 1100px; below that
     they sit in two even rows of three, not five and one. */
  @media (min-width: 900px) and (max-width: 1099px) {
    .tags {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
    }

    .tags li {
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .tags li {
      padding: 4px 10px;
      font-size: 12.5px;
    }
  }

  /* Phones: two tags fit on a line, so the tags sit in two equal columns,
     with an odd last one across the full width, which keeps the block's
     edges straight instead of ragged. */
  @media (max-width: 480px) {
    .tags {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .tags li:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  /* The narrowest phones: the tags get a little smaller, so the longest
     ones still fit two to a line. */
  @media (max-width: 359px) {
    .tags li {
      padding-inline: 7px;
      font-size: min(12.5px, 3.3vw);
    }
  }

  /* Leans away from the pointer, or from a finger pressing it, as if
     pushed at that spot (the script below sets the angles), and springs
     back when left */
  .portrait {
    width: 220px;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 22px;
    background: var(--tile);
    transform: perspective(600px) rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    transition:
      transform 0.8s var(--spring),
      scale 0.6s var(--spring);
  }

  .portrait.tilting {
    transition:
      transform 0.25s var(--ease-out),
      scale 0.15s var(--ease-out);
  }

  /* A finger also presses it in a little */
  .portrait.pressed {
    scale: 0.97;
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Phones: name and role on the left with the photo beside them, as on
     larger screens; the intro and everything below use the full width */
  @media (max-width: 760px) {
    .hero {
      grid-template-areas:
        'name portrait'
        'role portrait'
        'lead lead'
        'status status'
        'meta meta';
      column-gap: 16px;
      align-items: start;
    }

    .hero-text {
      display: contents;
    }

    h1 {
      grid-area: name;
      align-self: end;
    }

    .role {
      grid-area: role;
    }

    .lead {
      grid-area: lead;
    }

    .status {
      grid-area: status;
      justify-self: start;
    }

    .portrait-slot {
      align-self: center;
    }

    .portrait {
      width: clamp(84px, 25vw, 132px);
      border-radius: 18px;
    }
  }

  /* Phone type scale */
  @media (max-width: 600px) {
    h1 {
      font-size: clamp(32px, 9.6vw, 42px);
    }

    .role {
      margin-top: 6px;
      font-size: 15px;
    }

    .lead {
      margin-top: 18px;
      font-size: 15px;
    }

    .status {
      margin-top: 16px;
      font-size: 13px;
    }

    .interests {
      margin-top: 24px;
    }

    .interests-label {
      font-size: 11px;
    }

    .pills {
      margin-top: 20px;
    }
  }

  /* Phones and small tablets: the profile links are a row of round icon
     buttons (names kept for screen readers) */
  @media (max-width: 760px) {
    .pills {
      display: flex;
      flex-wrap: nowrap;
      gap: 12px;
    }

    .pills li {
      flex: 0 1 44px;
    }

    .pills a {
      justify-content: center;
      width: 100%;
      height: auto;
      aspect-ratio: 1;
      padding: 0;
    }

    .pills .label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .pills :global(svg) {
      width: 18px;
      height: 18px;
    }

    /* About 52px tall, and reaching into half the gap on either side */
    .pills .hit {
      inset: -5px -7px;
    }
  }

  /* Phones: the availability line is one full-width row, status on the
     left and the contact link on the right; the icon row spans the width */
  @media (max-width: 560px) {
    .status {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-self: stretch;
      gap: 4px 8px;
      padding: 10px 14px;
      border-radius: 14px;
      font-size: 12.5px;
    }

    .status .dot {
      margin-top: 0;
    }

    .status > span:not(.dot) {
      display: contents;
    }

    .status a {
      margin-left: auto;
      padding-left: 8px;
    }

    .pills {
      justify-content: space-between;
      gap: 6px;
    }
  }

  /* Narrow phones: keep the status and contact link on one line */
  @media (max-width: 380px) {
    .status {
      padding-inline: 12px;
      font-size: 12px;
    }
  }

  /* Publications
     ======================================================================== */

  .pub-list {
    display: grid;
    gap: clamp(28px, 4vw, 40px);
  }

  /* Phones: a row of equal-height cards that scrolls sideways; the next
     card peeks in from the right */
  @media (max-width: 560px) {
    .pub-list {
      grid-auto-flow: column;
      grid-auto-columns: 84%;
      gap: 12px;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      scroll-padding-inline: var(--gutter);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .pub-list::-webkit-scrollbar {
      display: none;
    }
  }

  /* News tiles
     ======================================================================== */

  .tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  @media (max-width: 860px) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .tiles {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }

  .news-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--card-edge);
    border-radius: var(--radius-lg);
    background: var(--tile);
    transition:
      background-color 0.3s,
      box-shadow 0.4s,
      translate 0.6s var(--spring),
      scale 0.6s var(--spring);
  }

  @media (hover: hover) {
    .news-tile:hover {
      background: var(--tile-hover);
    }
  }

  .news-tile .media {
    aspect-ratio: 16 / 10;
    border-radius: 0;
  }

  @media (hover: hover) {
    .news-tile:hover :global(img) {
      transform: scale(1.03);
    }
  }

  .news-body {
    padding: 16px 20px 20px;
  }

  .news-body h3 {
    margin-top: 4px;
    font-size: 16px;
    line-height: 1.4;
    letter-spacing: -0.012em;
  }

  /* Phones: a compact list with a thumbnail beside the date and summary */
  @media (max-width: 560px) {
    .news-tile {
      flex-direction: row;
      align-items: center;
      gap: 14px;
      padding: 10px;
      border-radius: var(--radius);
    }

    .news-tile .media {
      flex: none;
      width: 96px;
      aspect-ratio: 4 / 3;
      border-radius: var(--radius-sm);
    }

    .news-body {
      padding: 0 6px 0 0;
    }

    .news-body h3 {
      margin-top: 2px;
      font-size: 14.5px;
      line-height: 1.35;
    }
  }

  /* Education
     ======================================================================== */

  .edu li {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) auto;
    gap: 20px;
    align-items: start;
    padding-block: 22px;
  }

  /* Hairlines only between entries: the section's own rule sits above the
     title, as in the other sections, and the footer closes the page. */
  .edu li:first-child {
    padding-top: 0;
  }

  .edu li + li {
    border-top: 1px solid var(--line);
  }

  /* School logo, shown without a frame. Wordmarks and emblems both fit the box. */
