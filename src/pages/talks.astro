---
import { getCollection, getEntry } from 'astro:content';

import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import YouTube from '@/components/YouTube.astro';
import { site } from '@/config';
import { byFileOrder, formatMonth, groupByYear, isoMonth, wrapFriendly } from '@/utils/format';

// Video posters: files in src/assets/images/talks/ named after the talk id are
// picked up automatically; without one, the poster comes from YouTube.
const posterFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/talks/*.{png,jpg,jpeg,webp}', {
  eager: true,
});
function posterFor(id: string): ImageMetadata | undefined {
  const match = Object.entries(posterFiles).find(([path]) => path.split('/').pop()?.replace(/\.[^.]+$/, '') === id);
  return match?.[1].default;
}

// Shown in the order they appear in talks.yaml (newest first), grouped by year.
const talks = await Promise.all(
  (await getCollection('talks')).sort(byFileOrder).map(async (talk) => {
    // Link to the related paper's first link (usually the journal page).
    const paper = talk.data.paper ? await getEntry(talk.data.paper) : undefined;
    const videoUrl = talk.data.youtube && `https://www.youtube.com/watch?v=${talk.data.youtube}`;
    const paperUrl = paper?.data.links[0]?.url;
    // The title links to the recording, or else the paper, as a paper's title does.
    return { ...talk.data, poster: posterFor(talk.id), videoUrl, paperUrl, primary: videoUrl || paperUrl };
  }),
);
const groups = groupByYear(talks, (t) => t.date.slice(0, 4));
---

<BaseLayout title="Talks" description={`Talks and presentations by ${site.name}.`}>
  <PageHeader title="Talks">
    <p>Talks and presentations.</p>
  </PageHeader>

  <div class="container">
    {
      groups.map((group, g) => (
        <section class="year-group" aria-labelledby={`y${group.year}`}>
          <h2 class="sticky-year" data-liquid id={`y${group.year}`}>
            {group.year}
          </h2>

          <div class="items">
            {group.items.map((talk, i) => (
              <article class:list={['talk', 'reveal', { 'no-media': !talk.youtube }]}>
                {talk.youtube && (
                  <div class="media">
                    <YouTube id={talk.youtube} title={talk.title} poster={talk.poster} priority={g === 0 && i === 0} />
                  </div>
                )}

                <div class="meta">
                  <p class="eyebrow">
                    <span>
                      {talk.event} · <time datetime={isoMonth(talk.date)}>{formatMonth(talk.date)}</time>
                    </span>
                    {talk.note && <span class="badge">{talk.note}</span>}
                  </p>
                  <h3>
                    {talk.primary ? (
                      <a class="title-link" href={talk.primary} target="_blank" rel="noopener" set:html={wrapFriendly(talk.title)} />
                    ) : (
                      <Fragment set:html={wrapFriendly(talk.title)} />
                    )}
                  </h3>
                  <p class="location">{talk.location}</p>

                  <ul class="links">
                    {talk.videoUrl && (
                      <li>
                        <a class="chip" href={talk.videoUrl} target="_blank" rel="noopener">
                          YouTube
                          <span class="arrow" aria-hidden="true">
                            ↗
                          </span>
                        </a>
                      </li>
                    )}
                    {talk.paperUrl && (
                      <li>
                        <a class="chip" href={talk.paperUrl} target="_blank" rel="noopener">
                          Paper
                          <span class="arrow" aria-hidden="true">
                            ↗
                          </span>
                        </a>
                      </li>
                    )}
                  </ul>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .items {
    display: grid;
    gap: clamp(28px, 4vw, 40px);
  }

  /* Video on the left, details on the right (same rhythm as News) */
  .talk {
    display: grid;
    grid-template-columns: 340px minmax(0, 1fr);
    gap: clamp(24px, 4vw, 40px);
    align-items: start;
  }

  .talk.no-media {
    grid-template-columns: minmax(0, 1fr);
  }

  /* Hairline edge so white slides stand out from a white page in light mode */
  .media :global(.yt) {
    border: 1px solid var(--card-edge);
    border-radius: var(--radius-sm);
  }

  h3 {
    margin-top: 4px;
    font-size: 19px;
    line-height: 1.35;
    letter-spacing: -0.016em;
  }

  .location {
    margin-top: 4px;
    font-size: 14px;
    color: var(--text-3);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }

  /* A flex row keeps anything an extension adds after a link beside its chip. */
  .links li {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  @media (max-width: 760px) {
    .talk {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
  }

  /* Phone type scale */
  @media (max-width: 600px) {
    h3 {
      font-size: 16.5px;
    }

    .location {
      font-size: 13px;
    }
  }
</style>
