---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { site } from '@/config';
import { byFileOrder } from '@/utils/format';

const courses = (await getCollection('teaching')).sort(byFileOrder);
---

<BaseLayout title="Teaching" description={`Teaching by ${site.name} at ${site.affiliation}.`}>
  <PageHeader title="Teaching" />

  <div class="container list">
    {
      courses.map(({ data }) => (
        <article class="course reveal">
          <div class="logo frame">
            <Image src={data.image} alt={data.imageAlt} widths={[140, 280, 420]} sizes="140px" />
          </div>

          <div class="body">
            <p class="eyebrow">
              {data.term} · {data.role}
            </p>
            <h2>
              {data.course}: {data.title}
            </h2>
            <p class="desc">{data.description}</p>

            <div class="foot">
              <p class="instructor">
                Instructor:{' '}
                {data.instructor.url ? (
                  <a class="text-link" href={data.instructor.url} target="_blank" rel="noopener">
                    {data.instructor.name}
                  </a>
                ) : (
                  data.instructor.name
                )}
              </p>
              {data.links.map((link) => (
                <a class="chip" href={link.url} target="_blank" rel="noopener">
                  {link.label}
                  <span class="arrow" aria-hidden="true">
                    ↗
                  </span>
                </a>
              ))}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</BaseLayout>

<style>
  .list {
    display: grid;
    gap: 20px;
  }

  .course {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: clamp(20px, 3vw, 32px);
    padding: clamp(20px, 3vw, 28px);
    border: 1px solid var(--card-edge);
    border-radius: var(--radius-lg);
    background: var(--tile);
  }

  .logo {
    aspect-ratio: 1;
    align-self: start;
    border-radius: var(--radius);
  }

  h2 {
    margin-top: 4px;
    font-size: 19px;
    letter-spacing: -0.018em;
  }

  .body {
    display: flex;
    flex-direction: column;
  }

  .desc {
    margin-top: 8px;
    color: var(--text-2);
  }

  /* Instructor on the left, course link on the right, pinned to the bottom */
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 24px;
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    font-size: 14px;
  }

  .desc + .foot {
    margin-top: 18px;
  }

  .instructor {
    color: var(--text-3);
  }

  /* Phones: a small course image beside the term and title; the description
     and footer use the full width below */
  @media (max-width: 640px) {
    .course {
      grid-template-columns: 64px minmax(0, 1fr);
      column-gap: 16px;
      row-gap: 0;
    }

    .logo {
      grid-row: span 2;
      align-self: center;
      border-radius: var(--radius-sm);
    }

    .body {
      display: contents;
    }

    .eyebrow {
      grid-column: 2;
      align-self: end;
    }

    h2 {
      grid-column: 2;
      align-self: start;
      font-size: 17.5px;
    }

    .desc,
    .foot {
      grid-column: 1 / -1;
    }

    .desc {
      margin-top: 14px;
    }
  }
</style>
