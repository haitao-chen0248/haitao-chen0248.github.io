---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Slideshow from '@/components/Slideshow.astro';
import { site } from '@/config';
import { byNewest, formatMonth, groupByYear, isoMonth, wrapFriendly } from '@/utils/format';

const items = (await getCollection('news')).sort(byNewest);

// Render each Markdown body ahead of time, then group by year (newest first).
const entries = await Promise.all(items.map(async (item) => ({ item, ...(await render(item)) })));
const groups = groupByYear(entries, (e) => e.item.data.date.slice(0, 4));
---

<BaseLayout title="News" description={`News and milestones from ${site.name}.`}>
  <PageHeader title="News">
    <p>Milestones, papers, and conferences.</p>
  </PageHeader>

  <div class="container">
    {
      groups.map((group) => (
        <section class="year-group" aria-labelledby={`y${group.year}`}>
          <h2 class="year" id={`y${group.year}`}>
            {group.year}
          </h2>

          <ol class="entries">
            {group.items.map(({ item, Content }) => {
              const images = item.data.images;
              return (
                <li id={item.id} class:list={['entry', 'reveal', { 'no-media': images.length === 0 }]}>
                  {images.length > 0 && (
                    <div class="media">
                      <Slideshow images={images} sizes="(max-width: 760px) 100vw, 340px" />
                    </div>
                  )}

                  <div class="text">
                    <p class="eyebrow">
                      <time datetime={isoMonth(item.data.date)}>{formatMonth(item.data.date)}</time>
                    </p>
                    <h3 class="headline" set:html={wrapFriendly(item.data.title)} />
                    <div class="prose body">
                      <Content />
                    </div>
                  </div>
                </li>
              );
            })}
          </ol>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .year-group {
    padding-block: 20px 40px;
    border-top: 1px solid var(--line);
  }

  .year {
    margin-bottom: 20px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-2);
    font-variant-numeric: tabular-nums;
  }

  .entries {
    display: grid;
    gap: clamp(32px, 4vw, 44px);
  }

  /* Photos on the left, text on the right */
  .entry {
    display: grid;
    grid-template-columns: 340px minmax(0, 1fr);
    gap: clamp(24px, 4vw, 40px);
    align-items: start;
  }

  .entry.no-media {
    grid-template-columns: minmax(0, 1fr);
  }

  .headline {
    margin-top: 4px;
    font-size: 19px;
    line-height: 1.35;
    letter-spacing: -0.016em;
  }

  .body {
    max-width: 620px;
    margin-top: 8px;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--text-2);
  }

  /* Highlight the item linked from the home page */
  .entry:target .headline {
    color: var(--accent);
  }

  @media (max-width: 760px) {
    .entry {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
  }

  /* Phone type scale */
  @media (max-width: 600px) {
    .year {
      font-size: 14px;
    }

    .headline {
      font-size: 16.5px;
    }

    .body {
      font-size: 14.5px;
    }
  }
</style>
