---
// Shared page shell: <head> metadata, fonts, header, and footer.
// Geist for all text; Geist Mono for small labels such as dates and venues.
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
// The Latin file covers all of the site's text. Preloading it lets the first
// paint use Geist instead of swapping in from a fallback font.
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import '@/styles/global.css';

import { getImage } from 'astro:assets';

import Analytics from '@/components/Analytics.astro';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import headshot from '@/assets/images/headshot.jpg';
import { googleSiteVerification, links, site } from '@/config';
import { shareCardVersion } from '@/utils/og';

interface Props {
  /** Page name. Omit on the home page. */
  title?: string;
  description?: string;
  /** Keep this page out of search results (used by the 404 page). */
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Headshot URL for structured data.
const portrait = await getImage({ src: headshot, width: 600, format: 'jpg' });
const portraitUrl = new URL(portrait.src, Astro.site);

// Social share card, rendered at build time by src/pages/og.png.ts. The version
// query changes with the card's content so platforms fetch the new image.
const shareCardUrl = new URL(`/og.png?v=${shareCardVersion()}`, Astro.site);

// Structured data so search engines can identify the person behind the site.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: Astro.site?.toString(),
  image: portraitUrl.toString(),
  email: `mailto:${site.email}`,
  jobTitle: site.jobTitle,
  affiliation: { '@type': 'CollegeOrUniversity', name: site.affiliation },
  sameAs: links.filter((l) => l.href.startsWith('http')).map((l) => l.href),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark light" />

    <!-- Pick the theme before the first paint to avoid a flash:
         the visitor's saved choice, otherwise the system setting. -->
    <script is:inline>
      (() => {
        let theme = null;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]').content = theme === 'light' ? '#ffffff' : '#000000';
      })();
    </script>

    <!-- Arriving from another page: the content gets its own view transition
         layer, so it can fade in over a background that stays still (see
         "Page changes" in global.css). The name is only set for the length
         of the change. The link holds the first paint until <main> exists. -->
    <link rel="expect" href="#main" blocking="render" />
    <script is:inline>
      addEventListener('pagereveal', (event) => {
        const main = document.getElementById('main');
        if (!event.viewTransition || !main) return;
        main.style.viewTransitionName = 'page';
        event.viewTransition.finished.finally(() => main.style.removeProperty('view-transition-name'));
      });
    </script>
    <meta name="generator" content={Astro.generator} />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / social cards -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareCardUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, ${site.role}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <Analytics />
  </head>

  <body>
    <div class="ambient" aria-hidden="true">
      <div class="ambient-field"><span></span><span></span><span></span></div>
    </div>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Pointer light: glass surfaces and cards catch a soft highlight where the
      // pointer is, and the ambient light leans gently toward it. Elements
      // marked data-magnetic lean a few pixels toward the pointer too. Mouse
      // and trackpad only; touch screens keep the static look.
      if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
        const field = document.querySelector<HTMLElement>('.ambient-field');
        const still = matchMedia('(prefers-reduced-motion: reduce)');
        let x = 0;
        let y = 0;
        let target: HTMLElement | null = null;
        let magnet: HTMLElement | null = null;
        let pull = [0, 0];
        let frame = 0;

        const clamp = (value: number, limit: number) => Math.max(-limit, Math.min(limit, value));

        function release() {
          if (magnet) magnet.style.translate = '';
          magnet = null;
          pull = [0, 0];
        }

        function update() {
          frame = 0;
          if (target) {
            const box = target.getBoundingClientRect();
            target.style.setProperty('--mx', `${x - box.left}px`);
            target.style.setProperty('--my', `${y - box.top}px`);
          }
          if (field && !still.matches) {
            field.style.setProperty('--px', `${(x / innerWidth - 0.5) * 48}px`);
            field.style.setProperty('--py', `${(y / innerHeight - 0.5) * 32}px`);
          }
          if (magnet && !still.matches) {
            // Measure from the resting position, not the pulled one.
            const box = magnet.getBoundingClientRect();
            const cx = box.left - pull[0] + box.width / 2;
            const cy = box.top - pull[1] + box.height / 2;
            pull = [clamp((x - cx) * 0.3, 6), clamp((y - cy) * 0.3, 4)];
            magnet.style.translate = `${pull[0]}px ${pull[1]}px`;
          }
        }

        document.addEventListener(
          'pointermove',
          (event) => {
            x = event.clientX;
            y = event.clientY;
            target = (event.target as Element).closest<HTMLElement>('.glass, .sheen');
            const next = (event.target as Element).closest<HTMLElement>('[data-magnetic]');
            if (next !== magnet) {
              release();
              magnet = next;
            }
            frame ||= requestAnimationFrame(update);
          },
          { passive: true },
        );

        // Let go when the pointer leaves the window.
        document.addEventListener('pointerout', (event) => {
          if (!event.relatedTarget) release();
        });
      }
    </script>
  </body>
</html>

