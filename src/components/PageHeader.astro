---
// Title block at the top of each sub-page.
import Letters from './Letters.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<header class="container page-header">
  <h1><Letters text={title} /></h1>
  {
    Astro.slots.has('default') && (
      <div class="intro prose enter" style="--i: 1">
        <slot />
      </div>
    )
  }
</header>

<style>
  .page-header {
    padding-top: clamp(24px, 3.5vw, 40px);
    padding-bottom: clamp(18px, 2.5vw, 24px);
  }

  h1 {
    font-size: clamp(34px, 4.4vw, 46px);
    letter-spacing: -0.032em;
    line-height: 1.1;
  }

  .intro {
    max-width: 640px;
    margin-top: 8px;
    font-size: 16px;
    color: var(--text-2);
  }

  @media (max-width: 600px) {
    h1 {
      font-size: clamp(30px, 8.4vw, 34px);
    }

    .intro {
      font-size: 15px;
    }
  }
</style>
