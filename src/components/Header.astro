---
import { nav, site } from '@/config';
import AiryMark from './AiryMark.astro';

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container inner">
    <a href="/" class="brand" aria-label={`${site.name}, home`}>
      <AiryMark size={18} class="brand-mark" />
      <span class="brand-name">{site.name}</span>
    </a>

    <div class="right">
      <span class="lens glass" aria-hidden="true"></span>
      <nav aria-label="Main">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Light/dark switch. Icons from Feather (MIT); CSS shows the one that fits the current theme. -->
      <button class="theme-toggle" type="button" aria-label="Toggle light and dark mode" title="Toggle light and dark mode">
        <svg class="icon-sun" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </div>
  </div>
  <span class="progress" aria-hidden="true"></span>
</header>

<script>
  // Theme switch. The current theme is already on <html data-theme> (set by the
  // inline script in BaseLayout). A choice that matches the system setting is not
  // stored, so the site goes back to following the system.
  const KEY = 'theme';
  const root = document.documentElement;
  const systemQuery = matchMedia('(prefers-color-scheme: light)');
  const systemTheme = () => (systemQuery.matches ? 'light' : 'dark');

  function readSaved(): string | null {
    try {
      return localStorage.getItem(KEY);
    } catch {
      return null;
    }
  }

  function save(theme: string) {
    try {
      if (theme === systemTheme()) localStorage.removeItem(KEY);
      else localStorage.setItem(KEY, theme);
    } catch {
      /* Storage unavailable (private mode, blocked cookies): the switch still works for this page. */
    }
  }

  function apply(theme: string) {
    root.dataset.theme = theme;
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'light' ? '#ffffff' : '#000000');
  }

  // Height of the viewport with the browser bars retracted (100lvh). On
  // phones the page snapshot for a view transition covers this whole area,
  // which is taller than innerHeight while the bars are showing.
  function largeViewportHeight(): number {
    const probe = document.createElement('div');
    probe.style.cssText = 'position:fixed;top:0;height:100lvh;visibility:hidden;pointer-events:none';
    document.body.append(probe);
    const height = probe.offsetHeight;
    probe.remove();
    return height;
  }

  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
  toggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    save(next);
    if (!document.startViewTransition || matchMedia('(prefers-reduced-motion: reduce)').matches) {
      apply(next);
      return;
    }
    // The new theme spreads out from the switch as a growing circle. It is
    // sized to reach past the farthest corner of the snapshot, including the
    // area under the browser bars (counted twice, since the bars may sit at
    // the top or the bottom), so no strip is left to pop in at the end. The
    // easing keeps it moving until it reaches that corner.
    const box = toggle.getBoundingClientRect();
    const x = box.left + box.width / 2;
    const y = box.top + box.height / 2;
    const height = Math.max(innerHeight, largeViewportHeight());
    const bars = height - innerHeight;
    const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, height - y) + bars) + 24;
    root.classList.add('theme-switch');
    const transition = document.startViewTransition(() => apply(next));
    transition.ready
      .then(() =>
        root.animate(
          { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
          { duration: 600, easing: 'cubic-bezier(0.4, 0, 0.2, 1)', pseudoElement: '::view-transition-new(root)' },
        ),
      )
      .catch(() => {});
    transition.finished.finally(() => root.classList.remove('theme-switch'));
  });

  // Follow live system changes unless the visitor picked a theme.
  systemQuery.addEventListener('change', () => {
    if (!readSaved()) apply(systemTheme());
  });

  // Menu lens: a glass capsule that rests behind the current page's menu item
  // and glides to whichever item the pointer or keyboard focus is on.
  const bar = document.querySelector<HTMLElement>('.site-header .right');
  const lens = bar?.querySelector<HTMLElement>('.lens');
  if (bar && lens) {
    let current = bar.querySelector<HTMLElement>('nav a[aria-current="page"]');
    const initial = current;
    let active: HTMLElement | null = null;

    function place(item: HTMLElement | null, animate = true) {
      active = item;
      if (!item) {
        lens!.classList.remove('shown');
        return;
      }
      // Start from the item itself when the lens is not on screen yet.
      const jump = !animate || !lens!.classList.contains('shown');
      const box = item.getBoundingClientRect();
      const base = bar!.getBoundingClientRect();
      const pad = item.matches('nav a') ? parseFloat(getComputedStyle(bar!).getPropertyValue('--lens-pad')) : 0;
      const height = Math.max(box.height, 30);
      lens!.classList.toggle('instant', jump);
      lens!.style.setProperty('--lx', `${box.left - base.left - pad}px`);
      lens!.style.setProperty('--ly', `${box.top - base.top - (height - box.height) / 2}px`);
      lens!.style.setProperty('--lw', `${box.width + pad * 2}px`);
      lens!.style.setProperty('--lh', `${height}px`);
      if (jump) void lens!.offsetWidth;
      lens!.classList.remove('instant');
      lens!.classList.add('shown');
    }

    // On arrival the lens is simply there, without fading in, so during a page
    // change it carries straight over from the previous page's menu.
    function placeNow(item: HTMLElement | null) {
      lens!.style.transition = 'none';
      place(item, false);
      void lens!.offsetWidth;
      lens!.style.removeProperty('transition');
    }

    placeNow(current);

    for (const item of bar.querySelectorAll<HTMLElement>('nav a, .theme-toggle')) {
      item.addEventListener('pointerenter', () => place(item));
      item.addEventListener('focus', () => place(item));
      item.addEventListener('blur', () => place(current));
    }
    bar.addEventListener('pointerleave', () => place(current));

    // Pressing an item squeezes it and the lens a little; letting go springs
    // them back.
    let pressed: Element | null = null;
    bar.addEventListener('pointerdown', (event) => {
      pressed = (event.target as Element).closest('nav li, .theme-toggle');
      pressed?.classList.add('pressed');
      lens.classList.add('pressed');
    });
    const release = () => {
      pressed?.classList.remove('pressed');
      pressed = null;
      lens.classList.remove('pressed');
    };
    addEventListener('pointerup', release);
    addEventListener('pointercancel', release);

    // A chosen page becomes the current item right away, so the lens stays on
    // it while the next page loads and that page's menu picks up from there.
    for (const link of bar.querySelectorAll<HTMLAnchorElement>('nav a')) {
      link.addEventListener('click', (event) => {
        if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        current?.classList.remove('chosen');
        current = link;
        link.classList.add('chosen');
        place(link);
      });
    }

    // Coming back with the Back button can restore this page as it was left;
    // put the lens back on this page's own item.
    addEventListener('pageshow', (event) => {
      if (!event.persisted) return;
      current?.classList.remove('chosen');
      current = initial;
      placeNow(current);
    });

    new ResizeObserver(() => place(active, false)).observe(bar);
  }
</script>

<style>
  /* Frosted-glass bar. At the top of the page it is clear and lets the
     ambient light through; it frosts over as the page scrolls. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: var(--header-bg);
    border-bottom: 1px solid var(--line);
    backdrop-filter: saturate(180%) blur(20px);
    /* Keep the header still while pages cross-fade. */
    view-transition-name: site-header;
  }

  /* While the theme switches, the header is part of the page so the new theme
     sweeps over it too. */
  :global(.theme-switch) .site-header {
    view-transition-name: none;
  }

  /* The shorthand and the timeline sit in separate rules on purpose; see the
     note on .reveal in global.css. */
  @supports (animation-timeline: scroll()) {
    :where(.site-header) {
      animation: header-clear linear both;
    }

    .site-header {
      animation-timeline: scroll();
      animation-range: 0 64px;
    }
  }

  @keyframes header-clear {
    from {
      background-color: transparent;
      border-bottom-color: transparent;
    }
  }

  /* Reading progress: a hairline along the bottom of the bar that fills as
     the page scrolls. Only shown where scroll-driven animations work. */
  .progress {
    display: none;
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    transform: scaleX(0);
    transform-origin: left;
  }

  @supports (animation-timeline: scroll()) {
    :where(.progress) {
      animation: progress linear both;
    }

    .progress {
      display: block;
      animation-timeline: scroll(root);
    }
  }

  @keyframes progress {
    to {
      transform: scaleX(1);
    }
  }

  .inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .brand {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 9px;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.015em;
    white-space: nowrap;
  }

  .brand :global(.brand-mark) {
    color: var(--accent);
    transition: transform 0.6s var(--ease-out);
  }

  .brand:hover :global(.brand-mark) {
    transform: scale(1.12);
  }

  .right {
    --lens-pad: 12px;
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    gap: 20px;
  }

  /* Glass capsule behind the current or hovered menu item. It moves on a
     spring, so it overshoots a little and settles like a drop of liquid. */
  .lens {
    position: absolute;
    top: 0;
    left: 0;
    z-index: -1;
    width: var(--lw, 0px);
    height: var(--lh, 0px);
    border-radius: 999px;
    backdrop-filter: none;
    opacity: 0;
    transform: translate(var(--lx, 0px), var(--ly, 0px)) scale(var(--ls, 1));
    transition:
      opacity 0.25s,
      transform 0.6s var(--spring),
      width 0.6s var(--spring),
      height 0.6s var(--spring);
    pointer-events: none;
  }

  .lens.shown {
    opacity: 1;
  }

  .lens.pressed {
    --ls: 0.92;
    transition:
      opacity 0.25s,
      transform 0.15s var(--ease-out),
      width 0.6s var(--spring),
      height 0.6s var(--spring);
  }

  .lens.instant {
    transition: opacity 0.25s;
  }

  @media (prefers-reduced-motion: reduce) {
    .lens,
    .lens.pressed {
      --ls: 1;
      transition: opacity 0.25s;
    }
  }

  nav ul {
    display: flex;
    gap: 24px;
  }

  nav li {
    transition: scale 0.5s var(--spring);
  }

  nav a {
    font-size: 13.5px;
    color: var(--text-2);
    transition: color 0.2s;
  }

  nav a:hover,
  nav a[aria-current='page'],
  nav a.chosen,
  nav li.pressed a {
    color: var(--text);
  }

  /* Once another page is chosen, only that item stays highlighted */
  nav:has(.chosen) a[aria-current='page']:not(.chosen, :hover) {
    color: var(--text-2);
  }

  /* Pressed: a quick squeeze; the release springs back */
  nav li.pressed {
    scale: 0.94;
    transition: scale 0.12s var(--ease-out);
  }

  .theme-toggle.pressed {
    scale: 0.94;
    transition:
      color 0.2s,
      scale 0.12s var(--ease-out);
  }

  @media (prefers-reduced-motion: reduce) {
    nav li.pressed,
    .theme-toggle.pressed {
      scale: none;
    }
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    color: var(--text-2);
    transition:
      color 0.2s,
      scale 0.5s var(--spring);
  }

  .theme-toggle:hover {
    color: var(--text);
  }

  .theme-toggle svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icon-sun {
    display: var(--show-sun);
  }

  .icon-moon {
    display: var(--show-moon);
  }

  @media (max-width: 600px) {
    .right {
      --lens-pad: 8px;
      gap: 10px;
    }

    nav ul {
      gap: 14px;
    }

    nav a {
      font-size: 13px;
    }
  }

  /* On phones keep the logo mark and drop the name to make room for the menu */
  @media (max-width: 460px) {
    .brand-name {
      display: none;
    }
  }

  @media (max-width: 380px) {
    .inner {
      gap: 12px;
    }

    .right {
      --lens-pad: 7px;
      gap: 6px;
    }

    nav ul {
      gap: 11px;
    }

    nav a {
      font-size: 12.5px;
    }
  }
</style>
