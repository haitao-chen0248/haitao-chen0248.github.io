---
// Light field: the soft colored light behind the top of the page, drawn with
// WebGL instead of CSS, over a faint lattice like a camera array's. Because
// the page draws this light itself, glass that floats on it (elements marked
// data-field-glass) can truly refract it: the shader bends the light and the
// lattice near each glass edge, frosts them, and splits the colors a little,
// all on the graphics card in one pass.
//
// For now only on devices with a mouse or trackpad, and not for visitors who
// ask for less transparency. Elsewhere, or without WebGL, the CSS light and
// frosted glass stay as they are (see .ambient and .glass in global.css).
---

<canvas class="light-field" aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.light-field');
  const root = document.documentElement;
  const wanted =
    matchMedia('(hover: hover) and (pointer: fine)').matches &&
    !matchMedia('(prefers-reduced-transparency: reduce)').matches;
  const gl = canvas && wanted ? canvas.getContext('webgl', { antialias: false }) : null;

  if (canvas && gl) {
    const MAX = 12;
    const vertex = 'attribute vec2 a; void main() { gl_Position = vec4(a, 0.0, 1.0); }';
    // Colors are premultiplied throughout. Positions are in CSS px from the
    // canvas's top left.
    const fragment = `
      precision highp float;
      uniform vec2 size; uniform float scale; uniform vec2 lean;
      uniform vec4 glow[3]; uniform vec3 blob[3]; uniform vec4 dots; uniform vec4 fill;
      uniform int count; uniform vec4 rect[${MAX}]; uniform vec2 shape[${MAX}];

      vec4 over(vec4 top, vec4 under) { return top + under * (1.0 - top.a); }

      // The light at p: three glows (blob: center and radius), then the
      // lattice, brighter where the light falls. soft frosts the lattice's
      // dots, spreading each over a wider disc as dim as it is wide.
      vec4 light(vec2 p, float soft) {
        vec4 c = vec4(0.0);
        for (int i = 0; i < 3; i++) {
          c = over(glow[i] * max(1.0 - length(p - blob[i].xy) / blob[i].z, 0.0), c);
        }
        vec2 cell = mod(p - lean * 0.5, 22.0) - 11.0;
        float w = 1.0 + soft;
        float a = dots.a * (0.35 + 4.0 * c.a) / (w * w) * (1.0 - smoothstep(0.7 * w, 1.5 * w, length(cell)));
        c = over(vec4(dots.rgb * a, a), c);
        // Fades out down the page, as the CSS light's mask does
        return c * (1.0 - clamp((p.y - 270.0) / 630.0, 0.0, 1.0));
      }

      // Signed distance from a rounded box centered at 0
      float box(vec2 p, vec2 extent, float r) {
        vec2 q = abs(p) - extent + r;
        return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
      }

      void main() {
        vec2 p = vec2(gl_FragCoord.x, size.y * scale - gl_FragCoord.y) / scale;
        vec4 c = light(p, 0.0);
        for (int i = 0; i < ${MAX}; i++) {
          if (i >= count) break;
          vec2 extent = rect[i].zw * 0.5;
          vec2 q = p - rect[i].xy - extent;
          float r = min(shape[i].x, min(extent.x, extent.y));
          float d = box(q, extent, r);
          if (d > 1.0) continue;
          // Like a lens, the glass shows what is behind it slightly enlarged,
          // and near its edge takes its light from further in, so the light
          // there is stretched toward the edge. That pull eases to nothing
          // across the rim, never folding the light back on itself. Red,
          // green, and blue bend a little apart.
          vec2 e = vec2(0.5, 0.0);
          vec2 n = normalize(vec2(box(q + e, extent, r) - box(q - e, extent, r), box(q + e.yx, extent, r) - box(q - e.yx, extent, r)) + 1e-6);
          float rim = min(extent.y, 18.0);
          float k = 1.0 - clamp(-d / rim, 0.0, 1.0);
          vec2 bend = -q * 0.12 - n * k * k * rim * 0.5;
          vec4 g = light(p + bend, 0.35);
          g.g = light(p + bend * 1.15, 0.35).g;
          g.b = light(p + bend * 1.3, 0.35).b;
          // Frosted glass saturates what is behind it, then adds its fill
          float grey = dot(g.rgb, vec3(0.2126, 0.7152, 0.0722));
          g.rgb = clamp(mix(vec3(grey), g.rgb, 1.8), 0.0, g.a);
          g = over(fill, g);
          // shape.y: how far the glass has faded in
          c = mix(c, g, clamp(0.5 - d * scale, 0.0, 1.0) * shape[i].y);
        }
        gl_FragColor = c;
      }`;

    const compile = (type: number, source: string) => {
      const shader = gl.createShader(type)!;
      gl.shaderSource(shader, source);
      gl.compileShader(shader);
      return shader;
    };
    const program = gl.createProgram()!;
    gl.attachShader(program, compile(gl.VERTEX_SHADER, vertex));
    gl.attachShader(program, compile(gl.FRAGMENT_SHADER, fragment));
    gl.linkProgram(program);

    if (gl.getProgramParameter(program, gl.LINK_STATUS)) {
      gl.useProgram(program);
      gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
      const at = gl.getAttribLocation(program, 'a');
      gl.enableVertexAttribArray(at);
      gl.vertexAttribPointer(at, 2, gl.FLOAT, false, 0, 0);
      const u = (name: string) => gl.getUniformLocation(program, name);

      const glass = [...document.querySelectorAll<HTMLElement>('[data-field-glass]')].slice(0, MAX);
      const still = matchMedia('(prefers-reduced-motion: reduce)');
      const start = performance.now();
      let height = 0;
      // Each glow's resting center and radius, then how it drifts, as the
      // CSS version's drift-1 to drift-3: period (s), move (in widths), and
      // growth
      let blobs: number[][] = [];
      const drifts = [
        [23, -0.09, 0.12, 0.15],
        [31, 0.16, -0.1, -0.1],
        [37, 0.12, 0.18, 0.2],
      ];

      // Colors come from the theme's tokens, so they follow a theme switch.
      // A 2D canvas reads any CSS color (the build may have rewritten the
      // tokens as hex) back as #rrggbb, or rgba() when not opaque.
      const probe = document.createElement('canvas').getContext('2d')!;
      const rgba = (value: string) => {
        probe.fillStyle = value.trim() || 'transparent';
        const color = String(probe.fillStyle);
        const [r, g, b, a = 1] = color.startsWith('#')
          ? [1, 3, 5].map((i) => parseInt(color.slice(i, i + 2), 16))
          : color.match(/[\d.]+/g)!.map(Number);
        return [(r / 255) * a, (g / 255) * a, (b / 255) * a, a];
      };
      function colors() {
        const style = getComputedStyle(root);
        gl!.uniform4fv(u('glow'), [1, 2, 3].flatMap((i) => rgba(style.getPropertyValue(`--glow-${i}`))));
        gl!.uniform4fv(u('fill'), rgba(style.getPropertyValue('--glass-fill')));
        // Straight color and its strength; light() premultiplies it
        gl!.uniform4fv(u('dots'), root.dataset.theme === 'light' ? [0.1, 0.12, 0.2, 0.06] : [0.75, 0.85, 1, 0.08]);
      }

      // The canvas covers where the CSS light is, and reaches down past the
      // glass when that sits lower (on a narrow window, say). The glows sit
      // where the CSS version puts them (global.css).
      function resize() {
        const base = canvas!.getBoundingClientRect();
        const lowest = Math.max(0, ...glass.map((el) => el.getBoundingClientRect().bottom - base.top));
        height = Math.max(900, Math.ceil(lowest + 24));
        canvas!.style.height = `${height}px`;
        const width = canvas!.clientWidth;
        const ratio = Math.min(devicePixelRatio, 2);
        canvas!.width = Math.round(width * ratio);
        canvas!.height = Math.round(height * ratio);
        gl!.viewport(0, 0, canvas!.width, canvas!.height);
        gl!.uniform2f(u('size'), width, height);
        gl!.uniform1f(u('scale'), ratio);
        const clamp = (lo: number, value: number, hi: number) => Math.max(lo, Math.min(value, hi));
        blobs = [
          [width * 0.78, 140, clamp(420, width * 0.62, 880) / 2],
          [width * 0.1, 400, clamp(360, width * 0.48, 700) / 2],
          [width * 0.36, 120, clamp(320, width * 0.4, 600) / 2],
        ];
      }

      // The light leans toward the pointer, settling over about 2s. While
      // it settles, and the glass moves with the pointer, every frame is
      // drawn; otherwise only the slow drift moves, and every other frame
      // is enough. The glass also moves as the page opens, fading in.
      const lean = [0, 0];
      const aim = [0, 0];
      let lively = start + 2500;
      document.addEventListener(
        'pointermove',
        (event) => {
          aim[0] = (event.clientX / innerWidth - 0.5) * 48;
          aim[1] = (event.clientY / innerHeight - 0.5) * 32;
          lively = event.timeStamp + 2500;
        },
        { passive: true },
      );

      let last = start;
      function render(now: number) {
        const ease = 1 - Math.exp(-(now - last) / 500);
        last = now;
        if (!still.matches) {
          lean[0] += (aim[0] - lean[0]) * ease;
          lean[1] += (aim[1] - lean[1]) * ease;
        }
        // ease-in-out, there and back
        const time = still.matches ? 0 : (now - start) / 1000;
        const at = blobs.flatMap(([x, y, r], i) => {
          const [period, dx, dy, grow] = drifts[i];
          const t = 0.5 - 0.5 * Math.cos((Math.PI * time) / period);
          return [x + lean[0] + dx * 2 * r * t, y + lean[1] + dy * 2 * r * t, r * (1 + grow * t)];
        });
        gl!.uniform3fv(u('blob'), at);
        gl!.uniform2f(u('lean'), lean[0], lean[1]);
        // Each glass's box on the canvas (it moves as it fades in, on hover,
        // and with the pointer's pull), its corner radius, and its opacity
        const base = canvas!.getBoundingClientRect();
        const rects: number[] = [];
        const shapes: number[] = [];
        for (const el of glass) {
          const box = el.getBoundingClientRect();
          rects.push(box.left - base.left, box.top - base.top, box.width, box.height);
          const fade = el.closest<HTMLElement>('.enter') ?? el;
          shapes.push(parseFloat(getComputedStyle(el).borderTopLeftRadius) || 0, Number(getComputedStyle(fade).opacity));
        }
        gl!.uniform1i(u('count'), glass.length);
        if (glass.length) {
          gl!.uniform4fv(u('rect'), rects);
          gl!.uniform2fv(u('shape'), shapes);
        }
        gl!.drawArrays(gl!.TRIANGLE_STRIP, 0, 4);
      }

      // Drawn while the canvas is on screen and the tab is open
      let frame = 0;
      let shown = false;
      let odd = false;
      function tick(now: number) {
        frame = 0;
        odd = !odd;
        if (odd || now < lively) render(now);
        if (shown && !document.hidden && !gl!.isContextLost()) frame = requestAnimationFrame(tick);
      }
      const run = () => {
        if (!frame && shown && !document.hidden && !gl!.isContextLost()) frame = requestAnimationFrame(tick);
      };

      // Swapped in for the CSS light and glass, drawn at once so neither
      // ever goes missing
      root.classList.add('light-field-on');
      resize();
      colors();
      render(start);
      new MutationObserver(() => {
        colors();
        render(performance.now());
      }).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
      new ResizeObserver(() => {
        resize();
        render(performance.now());
      }).observe(document.body);
      new IntersectionObserver(([entry]) => {
        shown = entry.isIntersecting;
        run();
      }).observe(canvas);
      document.addEventListener('visibilitychange', run);
      // Should the graphics card drop the canvas, the CSS light and glass
      // come back
      canvas.addEventListener('webglcontextlost', () => root.classList.remove('light-field-on'));
    }
  }
</script>

<style>
  /* Where the CSS light is (global.css), and in its place once drawn */
  .light-field {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    z-index: -1;
    width: 100%;
    height: 900px;
    pointer-events: none;
  }

  :global(.light-field-on) .light-field {
    display: block;
  }

  :global(.light-field-on .ambient) {
    display: none;
  }

  /* The glass on it is drawn by the shader. A hover tint still shows. */
  :global(.light-field-on [data-field-glass]) {
    background: transparent;
    backdrop-filter: none;
  }
</style>
