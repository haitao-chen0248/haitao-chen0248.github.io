---
// Section title with an optional "View all" link on the right. As the
// section scrolls in, a rule draws across above it and the title rises.
// An optional oversized word sits faintly behind the title and drifts
// sideways while the section scrolls past.
interface Props {
  title: string;
  id?: string;
  href?: string;
  linkLabel?: string;
  /** Short word shown large and faint behind the title */
  ghost?: string;
}

const { title, id, href, linkLabel = 'View all', ghost } = Astro.props;
---

<div class="section-head">
  {ghost && <span class="ghost" aria-hidden="true">{ghost}</span>}
  <span class="rule" aria-hidden="true"></span>
  <h2 id={id}><span class="title">{title}</span></h2>
  {
    href && (
      <a class="more-link" href={href}>
        <span class="label">{linkLabel}</span>
        <span class="label-short">View all</span>
        <span class="arrow" aria-hidden="true">
          →
        </span>
      </a>
    )
  }
</div>

<style>
  .section-head {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: clamp(18px, 2.5vw, 26px);
  }

  h2 {
    font-size: clamp(22px, 2.6vw, 28px);
    letter-spacing: -0.022em;
  }

  /* Hairline above the title, halfway into the section's top padding */
  .rule {
    position: absolute;
    top: calc(clamp(14px, 2vw, 24px) * -1);
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--line);
    transform-origin: left;
  }

  .title {
    display: inline-block;
  }

  .ghost {
    --drift: clamp(32px, 6vw, 88px);
    position: absolute;
    z-index: -1;
    top: 50%;
    left: -0.06em;
    margin-top: -0.56em;
    font-size: clamp(64px, 11vw, 148px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--ghost);
    pointer-events: none;
    user-select: none;
  }

  /* High-contrast modes would paint it as full-strength text */
  @media (forced-colors: active) {
    .ghost {
      display: none;
    }
  }

  @keyframes ghost-drift {
    from {
      translate: calc(var(--drift) * -1) 0;
    }
    to {
      translate: var(--drift) 0;
    }
  }

  @keyframes draw {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.6em);
    }
  }

  /* The shorthand and the timeline sit in separate rules on purpose; see the
     note on .reveal in global.css. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .section-head {
        view-timeline: --head;
      }

      :where(.rule) {
        animation: draw linear both;
      }

      :where(.title, .section-head > a) {
        animation: rise linear both;
      }

      :where(.ghost) {
        animation: ghost-drift linear both;
      }

      .rule {
        animation-timeline: --head;
        animation-range: entry 0% cover 40%;
      }

      .title,
      .section-head > a {
        animation-timeline: --head;
        animation-range: entry 30% cover 45%;
      }

      .ghost {
        animation-timeline: --head;
        animation-range: cover 0% cover 100%;
      }
    }
  }

  .label-short {
    display: none;
  }

  /* Phones: "View all" instead of e.g. "All publications" keeps the title on one line */
  @media (max-width: 420px) {
    .label {
      display: none;
    }

    .label-short {
      display: inline;
    }
  }

  @media (max-width: 600px) {
    h2 {
      font-size: 20px;
    }
  }

  @media (max-width: 380px) {
    .section-head {
      gap: 12px;
    }
  }
</style>
