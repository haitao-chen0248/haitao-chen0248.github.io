---
// Section title with an optional "View all" link on the right.
interface Props {
  title: string;
  id?: string;
  href?: string;
  linkLabel?: string;
}

const { title, id, href, linkLabel = 'View all' } = Astro.props;
---

<div class="section-head">
  <h2 id={id}>{title}</h2>
  {
    href && (
      <a class="more-link" href={href}>
        <span class="label">{linkLabel}</span>
        <span class="label-short">View all</span>
        <span class="arrow" aria-hidden="true">
          →
        </span>
      </a>
    )
  }
</div>

<style>
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: clamp(18px, 2.5vw, 26px);
  }

  h2 {
    font-size: clamp(22px, 2.6vw, 28px);
    letter-spacing: -0.022em;
  }

  .label-short {
    display: none;
  }

  /* Phones: "View all" instead of e.g. "All publications" keeps the title on one line */
  @media (max-width: 420px) {
    .label {
      display: none;
    }

    .label-short {
      display: inline;
    }
  }

  @media (max-width: 380px) {
    .section-head {
      gap: 12px;
    }

    h2 {
      font-size: 21px;
    }
  }
</style>
