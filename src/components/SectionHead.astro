---
// Section title with an optional "View all" link on the right. As the
// section scrolls in, a rule draws across above it and the title rises.
interface Props {
  title: string;
  id?: string;
  href?: string;
  linkLabel?: string;
}

const { title, id, href, linkLabel = 'View all' } = Astro.props;
---

<div class="section-head">
  <span class="rule" aria-hidden="true"></span>
  <h2 id={id}><span class="title">{title}</span></h2>
  {
    href && (
      <a class="more-link" href={href}>
        <span class="label">{linkLabel}</span>
        <span class="label-short">View all</span>
        <span class="arrow" aria-hidden="true">
          →
        </span>
      </a>
    )
  }
</div>

<style>
  .section-head {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: clamp(18px, 2.5vw, 26px);
  }

  h2 {
    font-size: clamp(24px, 3vw, 32px);
    letter-spacing: -0.025em;
  }

  /* Hairline above the title, halfway into the section's top padding */
  .rule {
    position: absolute;
    top: calc(clamp(14px, 2vw, 24px) * -1);
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--line);
    transform-origin: left;
  }

  .title {
    display: inline-block;
  }

  @keyframes draw {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.6em);
    }
  }

  /* The shorthand and the timeline sit in separate rules on purpose; see the
     note on .reveal in global.css. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .section-head {
        view-timeline: --head;
      }

      :where(.rule) {
        animation: draw linear both;
      }

      :where(.title, .section-head > a) {
        animation: rise linear both;
      }

      .rule {
        animation-timeline: --head;
        animation-range: entry 0% cover 40%;
      }

      .title,
      .section-head > a {
        animation-timeline: --head;
        animation-range: entry 30% cover 45%;
      }
    }
  }

  .label-short {
    display: none;
  }

  /* Phones: "View all" instead of e.g. "All publications" keeps the title on one line */
  @media (max-width: 420px) {
    .label {
      display: none;
    }

    .label-short {
      display: inline;
    }
  }

  /* Phones: 22px, easing to 20px on the narrowest screens so titles stay
     on one line beside "View all" */
  @media (max-width: 600px) {
    h2 {
      font-size: clamp(20px, 6.2vw, 22px);
    }
  }

  @media (max-width: 380px) {
    .section-head {
      gap: 12px;
    }
  }
</style>
