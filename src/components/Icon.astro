interface Props {
  name: string;
  size?: number;
}

const { name, size = 16 } = Astro.props;
const icon = icons[name];
const paths = icon ? (Array.isArray(icon.path) ? icon.path : [icon.path]) : [];
---

{
  icon && (
    <svg width={size} height={size} viewBox={icon.viewBox} fill="currentColor" aria-hidden="true" focusable="false">
      {paths.map((d) => (
        <path d={d} />
      ))}
    </svg>
  )
}
