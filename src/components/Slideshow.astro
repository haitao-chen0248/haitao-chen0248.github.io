---
// Photo slideshow. One photo shows as a plain image; several cross-fade
// automatically with dots to jump between them, and on touch screens a
// sideways swipe moves to the next or previous photo. Autoplay pauses on
// hover, keyboard focus or touch, while the slideshow is off screen or the
// tab is hidden, and is off entirely for visitors who prefer reduced motion.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  images: { src: ImageMetadata; alt: string }[];
  /** Responsive `sizes` attribute for the images. */
  sizes: string;
  /** Milliseconds each photo stays on screen. */
  interval?: number;
  /** What the photos show, e.g. the news item's title. Screen readers use it
   * to tell one slideshow from another. */
  label?: string;
}

const { images, sizes, interval = 3000, label } = Astro.props;
const multiple = images.length > 1;
---

<div
  class:list={['slideshow', 'lift', { multiple }]}
  data-interval={interval}
  role={multiple ? 'region' : undefined}
  aria-roledescription={multiple ? 'carousel' : undefined}
  aria-label={multiple ? (label ? `Photos: ${label}` : 'Photos') : undefined}
>
  <div class="slides sheen">
    {
      images.map((img, i) => (
        <div
          class:list={['slide', { active: i === 0 }]}
          aria-roledescription={multiple ? 'slide' : undefined}
          aria-hidden={i === 0 ? undefined : 'true'}
        >
          <Image src={img.src} alt={img.alt} widths={[360, 540, 720]} sizes={sizes} />
        </div>
      ))
    }
  </div>

  {
    multiple && (
      <div class="dots">
        {images.map((_, i) => (
          <button
            type="button"
            class:list={['dot', { active: i === 0 }]}
            aria-label={`Show photo ${i + 1} of ${images.length}`}
            aria-current={i === 0 ? 'true' : undefined}
          />
        ))}
      </div>
    )
  }
</div>

<script>
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('.slideshow.multiple').forEach((show) => {
    const slides = [...show.querySelectorAll<HTMLElement>('.slide')];
    const dots = [...show.querySelectorAll<HTMLButtonElement>('.dot')];
    const delay = Number(show.dataset.interval) || 3000;
    let index = 0;
    let timer: number | undefined;
    let onScreen = false;
    let held = false; // hovered or focused
    let touched = false; // a finger is on the photo

    function go(next: number) {
      slides[index].classList.remove('active');
      slides[index].setAttribute('aria-hidden', 'true');
      dots[index].classList.remove('active');
      dots[index].removeAttribute('aria-current');
      index = (next + slides.length) % slides.length;
      slides[index].classList.add('active');
      slides[index].removeAttribute('aria-hidden');
      dots[index].classList.add('active');
      dots[index].setAttribute('aria-current', 'true');
    }

    function stop() {
      window.clearInterval(timer);
      timer = undefined;
    }

    function start() {
      stop();
      if (reduceMotion || held || touched || !onScreen || document.hidden) return;
      timer = window.setInterval(() => go(index + 1), delay);
    }

    // Swipe: the photo follows the finger, with the next (or previous) one
    // alongside, and slides the rest of the way or back on release. Vertical
    // scrolling and pinch zoom stay with the browser (touch-action below).
    let swipe:
      | {
          id: number;
          x: number; // where the finger came down
          y: number;
          width: number;
          dx: number; // how far it has moved sideways
          speed: number; // px per ms, over the last move
          time: number; // of the last move
          on: boolean; // moved far enough sideways to count as a swipe
          to?: number; // the photo coming in
        }
      | undefined;
    let swiped = false;
    let settling: number | undefined;

    // Clear what a swipe left on the slides, so the classes take over again.
    // The styles are applied before the transitions come back, so a photo that
    // has slid out does not then fade out over the new one.
    function settle() {
      window.clearTimeout(settling);
      for (const slide of slides) {
        if (!slide.style.length) continue;
        slide.style.transition = 'none';
        slide.style.removeProperty('opacity');
        slide.style.removeProperty('translate');
        getComputedStyle(slide).opacity;
        slide.style.removeProperty('transition');
      }
    }

    function follow(dx: number) {
      if (!swipe) return;
      const step = dx < 0 ? 1 : -1;
      const to = (index + step + slides.length) % slides.length;
      swipe.to = to;
      // Only these two show, even if a cross-fade was under way
      slides.forEach((slide, i) => {
        slide.style.transition = 'none';
        slide.style.opacity = i === index || i === to ? '1' : '0';
      });
      slides[index].style.translate = `${dx}px`;
      slides[to].style.translate = `${dx + step * swipe.width}px`;
    }

    function release(event: PointerEvent) {
      if (!swipe || event.pointerId !== swipe.id) return;
      const { on, dx, speed, time, width, to } = swipe;
      swipe = undefined;
      touched = false;
      if (on && to !== undefined) {
        swiped = true;
        const step = dx < 0 ? 1 : -1;
        // Far enough, or a quick flick the same way that did not stop before
        // the finger lifted
        const flick = Math.abs(speed) > 0.3 && Math.sign(speed) === Math.sign(dx) && event.timeStamp - time < 100;
        const done = event.type === 'pointerup' && (Math.abs(dx) > width * 0.2 || flick);
        const from = slides[index];
        const next = slides[to];
        from.style.transition = next.style.transition = 'translate 0.45s var(--ease-out)';
        if (done) {
          go(to);
          from.style.translate = `${-step * width}px`;
          next.style.translate = '0px';
        } else {
          from.style.translate = '0px';
          next.style.translate = `${step * width}px`;
        }
        settling = window.setTimeout(settle, 450);
      }
      start();
    }

    show.addEventListener('pointerdown', (event) => {
      swiped = false;
      if (event.pointerType === 'mouse' || !event.isPrimary) return;
      settle();
      swipe = {
        id: event.pointerId,
        x: event.clientX,
        y: event.clientY,
        width: slides[index].clientWidth,
        dx: 0,
        speed: 0,
        time: event.timeStamp,
        on: false,
      };
      touched = true;
      stop();
    });

    show.addEventListener('pointermove', (event) => {
      if (!swipe || event.pointerId !== swipe.id) return;
      const dx = event.clientX - swipe.x;
      // Wait until the finger has clearly moved sideways
      if (!swipe.on && (Math.abs(dx) < 10 || Math.abs(dx) < Math.abs(event.clientY - swipe.y))) return;
      swipe.on = true;
      const elapsed = event.timeStamp - swipe.time;
      if (elapsed > 0) swipe.speed = (dx - swipe.dx) / elapsed;
      swipe.dx = dx;
      swipe.time = event.timeStamp;
      follow(dx);
    });

    show.addEventListener('pointerup', release);
    show.addEventListener('pointercancel', release);

    // A swipe that starts on a dot does not also pick that dot.
    show.addEventListener(
      'click',
      (event) => {
        if (swiped) event.stopPropagation();
      },
      true,
    );

    dots.forEach((dot, i) =>
      dot.addEventListener('click', () => {
        settle();
        go(i);
        start();
      }),
    );

    const hold = (value: boolean) => () => {
      held = value;
      start();
    };
    show.addEventListener('mouseenter', hold(true));
    show.addEventListener('mouseleave', hold(false));
    show.addEventListener('focusin', hold(true));
    show.addEventListener('focusout', hold(false));

    new IntersectionObserver(
      ([entry]) => {
        onScreen = entry.isIntersecting;
        start();
      },
      { threshold: 0.4 },
    ).observe(show);

    document.addEventListener('visibilitychange', start);
  });
</script>

<style>
  /* Rises on hover and catches the pointer light, like the other cards */
  .slideshow {
    position: relative;
    border-radius: var(--radius-sm);
  }

  /* Sideways swipes go to the script; the browser keeps vertical scrolling
     and pinch zoom */
  .multiple {
    touch-action: pan-y pinch-zoom;
  }

  .slides {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border: 1px solid var(--card-edge);
    border-radius: var(--radius-sm);
    background: var(--tile);
  }

  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.9s var(--ease);
  }

  .slide.active {
    opacity: 1;
  }

  .slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-out);
  }

  @media (hover: hover) {
    .slideshow:hover .slide :global(img) {
      transform: scale(1.03);
    }
  }

  /* Small dots on a glass capsule over the bottom of the photo. Each dot is
     a 24px button (the smallest comfortable touch target), with the visible
     dot drawn in its middle; the buttons reach past the capsule's top and
     bottom, so the capsule keeps its slim look. */
  .dots {
    position: absolute;
    left: 50%;
    bottom: 10px;
    display: flex;
    padding: 5px 0;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.28);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.28),
      inset 0 0 0 1px rgb(255 255 255 / 0.12),
      0 2px 10px rgb(0 0 0 / 0.2);
    backdrop-filter: blur(10px) saturate(180%);
    transform: translateX(-50%);
  }

  .dot {
    position: relative;
    width: 24px;
    height: 24px;
    margin-block: -9px;
    transition: width 0.6s var(--spring);
  }

  .dot::before {
    content: '';
    position: absolute;
    inset: 9px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.5);
    transition: background-color 0.3s;
  }

  .dot:hover::before {
    background: rgb(255 255 255 / 0.8);
  }

  /* The current photo's dot stretches into a 16px pill */
  .dot.active {
    width: 34px;
  }

  .dot.active::before {
    background: #fff;
  }

  /* The focus ring goes round the visible dot, not the whole button */
  .dot:focus-visible {
    outline: none;
  }

  .dot:focus-visible::before {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
</style>
