---
// Edge refraction for glass surfaces that float over content (header, photo
// dots, sticky year labels, section dock): near its edges, a surface bends
// what lies behind it, like the rim of a lens. Each surface marked
// data-refract gets an SVG displacement map the size of its box, used through
// --refract in its backdrop-filter. data-refract="before" sizes the map to the
// element's ::before, where that surface is drawn.
//
// Only Chromium renders SVG filters in backdrop-filter; other browsers, and
// visitors who ask for less transparency, keep the plain frosted glass.
---

<script>
  type Brands = { brands?: { brand: string }[] };
  const ua = (navigator as Navigator & { userAgentData?: Brands }).userAgentData;
  const chromium = ua?.brands?.some((b) => b.brand === 'Chromium') ?? false;
  const surfaces = document.querySelectorAll<HTMLElement>('[data-refract]');

  if (chromium && surfaces.length && !matchMedia('(prefers-reduced-transparency: reduce)').matches) {
    const ns = 'http://www.w3.org/2000/svg';
    const defs = document.createElementNS(ns, 'svg');
    defs.setAttribute('aria-hidden', 'true');
    defs.style.cssText = 'position:absolute;width:0;height:0;overflow:hidden';
    document.body.append(defs);
    document.documentElement.classList.add('refract');

    // Signed distance from a point (relative to the center) to the edge of a
    // rounded rectangle: negative inside.
    function edge(x: number, y: number, hw: number, hh: number, r: number) {
      const qx = Math.abs(x) - hw + r;
      const qy = Math.abs(y) - hh + r;
      return Math.hypot(Math.max(qx, 0), Math.max(qy, 0)) + Math.min(Math.max(qx, qy), 0) - r;
    }

    // Displacement map: red and green hold the sideways and vertical shift
    // (128 = none). Within `band` px of the edge, each point takes its color
    // from further inside, more so the closer it is to the edge.
    function map(w: number, h: number, r: number, band: number) {
      const canvas = document.createElement('canvas');
      canvas.width = w;
      canvas.height = h;
      const ctx = canvas.getContext('2d')!;
      const image = ctx.createImageData(w, h);
      const hw = w / 2;
      const hh = h / 2;
      for (let j = 0; j < h; j++) {
        for (let i = 0; i < w; i++) {
          const x = i + 0.5 - hw;
          const y = j + 0.5 - hh;
          const d = -edge(x, y, hw, hh, r);
          let dx = 0;
          let dy = 0;
          if (d < band) {
            // Outward direction of the edge, from the change in distance
            const nx = edge(x + 0.5, y, hw, hh, r) - edge(x - 0.5, y, hw, hh, r);
            const ny = edge(x, y + 0.5, hw, hh, r) - edge(x, y - 0.5, hw, hh, r);
            const len = Math.hypot(nx, ny) || 1;
            const k = (1 - Math.max(d, 0) / band) ** 2;
            dx = (-nx / len) * k;
            dy = (-ny / len) * k;
          }
          const o = (j * w + i) * 4;
          image.data[o] = 128 + dx * 127;
          image.data[o + 1] = 128 + dy * 127;
          image.data[o + 2] = 128;
          image.data[o + 3] = 255;
        }
      }
      ctx.putImageData(image, 0, 0);
      return canvas.toDataURL();
    }

    surfaces.forEach((surface, n) => {
      const id = `refract-${n}`;
      const filter = document.createElementNS(ns, 'filter');
      filter.id = id;
      filter.setAttribute('filterUnits', 'userSpaceOnUse');
      filter.setAttribute('color-interpolation-filters', 'sRGB');
      const image = document.createElementNS(ns, 'feImage');
      image.setAttribute('preserveAspectRatio', 'none');
      image.setAttribute('result', 'map');
      const shift = document.createElementNS(ns, 'feDisplacementMap');
      shift.setAttribute('in', 'SourceGraphic');
      shift.setAttribute('in2', 'map');
      shift.setAttribute('xChannelSelector', 'R');
      shift.setAttribute('yChannelSelector', 'G');
      filter.append(image, shift);
      defs.append(filter);

      const pseudo = surface.dataset.refract === 'before' ? '::before' : null;
      let size = '';
      const update = () => {
        const style = getComputedStyle(surface, pseudo);
        const w = Math.round(parseFloat(style.width));
        const h = Math.round(parseFloat(style.height));
        if (!w || !h || `${w}x${h}` === size) return;
        size = `${w}x${h}`;
        const r = Math.min(parseFloat(style.borderTopLeftRadius) || 0, w / 2, h / 2);
        const band = Math.min(h / 2, 18);
        for (const [key, value] of Object.entries({ x: 0, y: 0, width: w, height: h })) {
          filter.setAttribute(key, String(value));
          image.setAttribute(key, String(value));
        }
        image.setAttribute('href', map(w, h, r, band));
        shift.setAttribute('scale', String(Math.min(h, 36)));
        surface.style.setProperty('--refract', `url(#${id})`);
      };
      update();
      new ResizeObserver(update).observe(surface);
    });
  }
</script>
