---
// Lightweight YouTube embed. Shows a poster image first and loads the real
// player only after a click, which keeps pages fast and avoids third-party
// scripts until the visitor asks for them. Without JavaScript the poster
// simply links to the video on YouTube.
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
const watchUrl = `https://www.youtube.com/watch?v=${id}`;
const poster = `https://i.ytimg.com/vi/${id}/maxresdefault.jpg`;
// Older uploads may lack a max-resolution poster, so fall back to the HQ one.
// If that fails too (e.g. blocked by a network filter), hide the image and
// let the gradient background show instead of a broken-image icon.
const fallback =
  "if(this.src.includes('maxresdefault')){this.src=this.src.replace('maxresdefault','hqdefault')}else{this.onerror=null;this.style.visibility='hidden'}";
---

<div class="yt" data-youtube-id={id} data-youtube-title={title}>
  <a class="poster" href={watchUrl} target="_blank" rel="noopener">
    <img src={poster} alt="" loading="lazy" decoding="async" width="1280" height="720" onerror={fallback} />
    <span class="play" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="18" height="18"><path d="M8 5.5v13l11-6.5z" fill="currentColor"></path></svg>
    </span>
    <span class="visually-hidden">Play video: {title}</span>
  </a>
</div>

<script>
  // Replace the poster with the YouTube player on click.
  function activate(container: HTMLElement) {
    const iframe = document.createElement('iframe');
    iframe.src = `https://www.youtube-nocookie.com/embed/${container.dataset.youtubeId}?autoplay=1&rel=0`;
    iframe.title = container.dataset.youtubeTitle ?? 'YouTube video';
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    iframe.allowFullscreen = true;
    container.replaceChildren(iframe);
  }

  document.querySelectorAll<HTMLElement>('[data-youtube-id]').forEach((container) => {
    container.querySelector('a')?.addEventListener('click', (event) => {
      // Let modified clicks open YouTube in a new tab as usual.
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
      event.preventDefault();
      activate(container);
    });
  });
</script>

<style>
  .yt {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius);
    /* Visible while the poster loads or if it is blocked */
    background: var(--tile);
  }

  .poster,
  .yt :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-out);
  }

  .poster:hover img {
    transform: scale(1.03);
  }

  /* Frosted round play button */
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    color: #fff;
    background: rgb(40 40 42 / 0.6);
    backdrop-filter: blur(12px) saturate(180%);
    -webkit-backdrop-filter: blur(12px) saturate(180%);
    transform: translate(-50%, -50%);
    transition: transform 0.3s var(--ease), background-color 0.3s;
  }

  .play svg {
    margin-left: 2px;
  }

  .poster:hover .play {
    background: rgb(40 40 42 / 0.8);
    transform: translate(-50%, -50%) scale(1.06);
  }
</style>
